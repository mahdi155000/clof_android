<?xml version="1.0" encoding="utf-8"?>
<!--
    Automatic backup policy for Android 12 and later:
    - Cloud backup and device transfer include the Room database and settings.
    - Manual SAF export/import is a separate, user-controlled backup path.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="clof.db" />
        <include domain="sharedpref" path="clof_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="clof.db" />
        <include domain="sharedpref" path="clof_settings.xml" />
    </device-transfer>
</data-extraction-rules>