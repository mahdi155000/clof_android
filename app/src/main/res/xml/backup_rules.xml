<?xml version="1.0" encoding="utf-8"?>
<!--
    Automatic backup policy for Android 11 and earlier:
    - Include the Room database and app settings.
    - Exclude all other app files and caches.
    Manual SAF export/import remains available independently of this policy.
-->
<full-backup-content>
    <include domain="database" path="clof.db" />
    <include domain="sharedpref" path="clof_settings.xml" />
</full-backup-content>